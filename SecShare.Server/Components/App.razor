@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using SecShare.Web.Components

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SecShare - Encrypted file and secret sharing from your terminal</title>
    <meta name="description" content="Share encrypted files and secrets from the terminal with temporary links and browser-friendly receiving." />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["css/app.min.css"]" />
    <link rel="icon" href="@Assets["images/favicons/favicon.ico"]" sizes="any" />
    <link rel="icon" href="@Assets["images/favicons/favicon.svg"]" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="@Assets["images/app-icons/apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />
    <ImportMap />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <div id="app" class="min-h-screen bg-[#f7f8f5] text-[#13201d]">
        <SecShare.Web.Components.Routes @rendermode="@PageRenderMode" />
    </div>
    <script src="@Assets["js/secshare-interop.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private static readonly IComponentRenderMode InteractiveWebAssemblyWithoutPrerender =
        new InteractiveWebAssemblyRenderMode(prerender: false);

    private bool IsHomePath => HttpContext.Request.Path == "/";

    private IComponentRenderMode? PageRenderMode =>
        IsHomePath
            ? null
            : InteractiveWebAssemblyWithoutPrerender;
}
