<div class="rounded-xl border border-[#dce5da] bg-white/80 p-8 shadow-sm">
    <div class="mb-6">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-[#dce5da] bg-[#f7f8f5]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#52625d]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        <h1 class="text-base font-semibold text-[#13201d]">Decryption key required</h1>
        <p class="mt-2 text-sm leading-6 text-[#52625d]">
            @if (HasKeyFromLink)
            {
                <text>The decryption key from this link is ready. Select Decrypt to continue.</text>
            }
            else
            {
                <text>This link does not include the decryption key. Ask the sender for the key and paste it below.</text>
            }
        </p>
    </div>
    <div class="space-y-3">
        <input @bind="KeyInput"
               @onkeydown="OnKeyDown"
               type="text"
               placeholder="Paste decryption key…"
               autocomplete="off"
               spellcheck="false"
               class="w-full rounded-lg border border-[#dce5da] bg-white px-4 py-2.5 font-mono text-sm text-[#13201d] placeholder:text-[#a0afa9] focus:border-[#0f766e] focus:outline-none focus:ring-1 focus:ring-[#0f766e]" />
        @if (!string.IsNullOrEmpty(KeyError))
        {
            <p class="text-xs text-red-600">@KeyError</p>
        }
        <button @onclick="OnDecrypt"
                disabled="@IsDecrypting"
                class="w-full rounded-lg bg-[#13201d] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#223530] disabled:cursor-not-allowed disabled:opacity-60 focus-ring">
            @(IsDecrypting ? "Decrypting…" : "Decrypt")
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string KeyInput { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> KeyInputChanged { get; set; }

    [Parameter]
    public string? KeyError { get; set; }

    [Parameter]
    public bool HasKeyFromLink { get; set; }

    [Parameter]
    public bool IsDecrypting { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public EventCallback OnDecrypt { get; set; }
}
